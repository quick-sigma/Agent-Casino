    GRAPE = "GRAPE"
    BELL = "BELL"
    SEVEN = "SEVEN"
    DIAMOND = "DIAMOND"


class OutcomeKind(StrEnum):
    JACKPOT = "JACKPOT"
    WIN = "WIN"
    NEAR_MISS = "NEAR_MISS"
    LOSS = "LOSS"


GAME_NAME = "slots"

_REEL_1 = (
    (Symbol.CHERRY,) * 5
    + (Symbol.LEMON,) * 4
    + (Symbol.GRAPE,) * 3
    + (Symbol.BELL,) * 2
    + (Symbol.SEVEN,) * 5
    + (Symbol.DIAMOND,) * 1
)
