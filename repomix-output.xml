    (Symbol.CHERRY,) * 6
    + (Symbol.LEMON,) * 5
    + (Symbol.GRAPE,) * 4
    + (Symbol.BELL,) * 3
    + (Symbol.SEVEN,) * 1
    + (Symbol.DIAMOND,) * 1
)

